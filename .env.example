# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
PORTAL_BASE_URL=http://localhost:3000
MARKETING_SITE_URL=https://joinfindex.com/

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

POSTMARK_SERVER_TOKEN=
ONBOARDING_FROM_EMAIL=FinDex <christina@aquamark.io>
ONBOARDING_NOTIFY_EMAIL=christina@aquamark.io

JWT_SECRET=
# The first admin: can always sign in to /admin with an emailed code. Add more admins at /admin/settings.
ADMIN_OWNER_EMAIL=
# Old shared admin password: still works while set. Delete it once code sign-in works.
ADMIN_PASSWORD=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=

# Optional, later: Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
