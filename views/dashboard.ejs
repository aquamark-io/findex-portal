<%- include('partials/head') %>
<% const a = account; %>
<section class="card">
  <% if (typeof msg !== 'undefined' && msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <h1 class="title">Welcome<%= a.first_name ? `, ${a.first_name}` : '' %></h1>
  <% if (a.account_type === 'company') { %>
    <p class="lead"><%= a.business_legal_name %><% if (a.company_type) { %> &middot; <%= COMPANY_TYPES[a.company_type] %><% } %></p>
    <% if (!a.terms_version) { %>
    <p>View and dispute any report about your company at no cost, below.</p>
    <p class="muted">Searching and reporting require full access.</p>
    <p><a class="btn" href="/dashboard/full-access">Get full access</a></p>
    <% } else { %>
    <h2>Your Access</h2>
    <ul class="checklist">
      <li>Search individuals, companies and funded businesses</li>
      <li>Submit documented incident reports for independent review</li>
      <% if (canReportRepayment) { %><li>Report funded business repayment issues (missed payments, defaults)</li><% } %>
      <li>View, dispute, or appeal any report about your own company</li>
    </ul>
    <p class="mt"><a class="btn" href="/search">Search</a> <a class="btn secondary" href="/reports/new">Submit a report</a> <a class="btn secondary" href="/reports">Your reports</a></p>
    <% } %>
  <% } else if (a.account_type === 'individual') { %>
    <p class="lead">Your FinDex record</p>
    <p>View and dispute any report about you at no cost, below.</p>
  <% } else { %>
    <p class="lead"><%= a.business_legal_name %></p>
    <p>View and dispute any report about your business at no cost, below.</p>
  <% } %>
</section>

<section class="card">
  <h2 class="flush-top"><%= a.account_type === 'individual' ? 'Reports about you' : 'Reports about ' + (a.business_legal_name || 'your business') %></h2>
  <% if (!aboutMe.length) { %>
    <p class="muted flush">There are no reports about <%= a.account_type === 'individual' ? 'you' : 'your ' + (a.account_type === 'company' ? 'company' : 'business') %> on FinDex.</p>
  <% } else { %>
    <% aboutMe.forEach(r => { %>
      <article class="record-item">
        <div class="record-head">
          <strong><%= CATEGORIES[r.category].label %></strong>
          <span class="pill <%= r.status %>"><%= r.status === 'published' ? 'Published' : r.status === 'notice_sent' ? 'Publishes ' + fmtDay(r.publish_at) : r.status === 'disputed' ? 'Disputed' : 'Pending notice' %></span>
        </div>
        <dl class="kv">
          <dt>Reported by</dt><dd><%= r.reporter ? r.reporter.business_legal_name : '' %></dd>
          <dt>Incident date</dt><dd><%= new Date(r.incident_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %></dd>
          <% if (r.payment_amount != null) { %><dt>Amount</dt><dd><%= '$' + Number(r.payment_amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd><% } %>
          <% if (r.payment_status) { %><dt>Status reported</dt><dd><%= r.payment_status %></dd><% } %>
        </dl>
        <p class="prewrap"><%= r.description %></p>
        <% if ((aboutFiles[r.id] || []).length) { %>
          <p class="muted flush">Evidence:</p>
          <ul class="checklist"><% aboutFiles[r.id].forEach(f => { %><li><a href="/my-record/files/<%= f.id %>" target="_blank" rel="noopener"><%= f.file_name %></a> <span class="muted">(<%= fmtSize(f.size_bytes) %>)</span></li><% }) %></ul>
        <% } %>
        <% if (disputes[r.id]) { %>
          <p class="muted flush mt">Your dispute is under review. The report is withheld until we decide, by <%= fmtDay(disputes[r.id].due_at) %>.</p>
        <% } else if (DISPUTABLE.includes(r.status)) { %>
          <p class="flush mt"><a class="btn secondary" href="/my-record/reports/<%= r.id %>/dispute">Dispute</a></p>
        <% } %>
      </article>
    <% }) %>
    <p class="muted">Disputing is free. Disputed reports are withheld while we review the evidence.</p>
  <% } %>
  <% if (viewers.length) { %>
    <h2>Who has viewed your record</h2>
    <ul class="history">
      <% viewers.forEach(s => { %><li><%= s.fx_accounts ? s.fx_accounts.business_legal_name : 'A FinDex member' %> <span class="muted">&middot; <%= PURPOSES[s.purpose] %> &middot; <%= fmtDay(s.created_at) %></span></li><% }) %>
    </ul>
  <% } %>
  <% if (a.account_type === 'individual') { %>
    <p class="muted"><a href="<%= CFPB_SUMMARY_URL %>" target="_blank" rel="noopener">A Summary of Your Rights Under the Fair Credit Reporting Act</a></p>
  <% } %>
</section>
<%- include('partials/foot') %>
