<%- include('partials/head') %>
<% const a = account; %>
<section class="card">
  <% if (typeof msg !== 'undefined' && msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <h1 class="title">Welcome<%= a.first_name ? `, ${a.first_name}` : '' %></h1>
  <% if (a.account_type === 'company') { %>
    <p class="lead"><%= a.business_legal_name %><% if (a.company_type) { %> &middot; <%= COMPANY_TYPES[a.company_type] %><% } %></p>
    <% if (!a.terms_version) { %>
    <p>View and dispute any report about your company at no cost, below.</p>
    <p class="muted">Searching and reporting require full access.</p>
    <p><a class="btn" href="/dashboard/full-access">Get full access</a></p>
    <% } else { %>
    <h2>Your Access</h2>
    <ul class="checklist">
      <li>Check funded businesses before funding, and vendors before working with them</li>
      <li>Screen employees and contractors (FCRA, employment screening only)</li>
      <li>Report <% if (canReportRepayment) { %>defaults and <% } %>incidents, with evidence, for independent review</li>
      <li>View or dispute any report about your own company</li>
    </ul>
    <p class="mt"><a class="btn" href="/search">Search</a> <a class="btn secondary" href="/reports/new">Submit a report</a> <a class="btn secondary" href="/reports">Your reports</a></p>
    <% } %>
  <% } else if (a.account_type === 'individual') { %>
    <p class="lead">Your FinDex record</p>
    <p>View and dispute any report about you at no cost, below.</p>
  <% } else { %>
    <p class="lead"><%= a.business_legal_name %></p>
    <p>View and dispute any report about your business at no cost, below.</p>
  <% } %>
</section>

<% if (canUseApi) { %>
<section class="card">
  <h2 class="flush-top">API access</h2>
  <p>Check funded businesses for defaults and document tampering from your own systems.</p>
  <% if (!apiAccess || ['denied', 'revoked'].includes(apiAccess.status)) { %>
    <p><a class="btn" href="/api-access">Request API access</a></p>
  <% } else if (apiAccess.status === 'requested') { %>
    <p class="muted">Requested. We&rsquo;ll email you once it has been reviewed.</p>
  <% } else { %>
    <p><a class="btn" href="/api-access">Manage API keys</a></p>
  <% } %>
</section>
<% } %>
<% if (!(a.account_type === 'company' && a.terms_version)) { %>
<%- include('partials/about-me') %>
<% } %>
<%- include('partials/foot') %>
