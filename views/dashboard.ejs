<%- include('partials/head') %>
<% const a = account, pr = profile;
   const day = d => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' }) : '';
   const phone = p => { const m = /^\+1(\d{3})(\d{3})(\d{4})$/.exec(p || ''); return m ? `(${m[1]}) ${m[2]}-${m[3]}` : p; };
   const name = `${pr.first_name || ''} ${pr.last_name || ''}`.trim();
   const fullAccess = a.account_type === 'company' && a.terms_version;
   // Shown by default; the rest appears under "See more".
   let main, more;
   if (a.account_type === 'company') {
     main = [['Name', name], ['Company', pr.business_legal_name], ['Email', pr.email], ['Member since', day(pr.created_at)], ['Role', COMPANY_TYPES[pr.company_type]]];
     more = [['DBA', pr.business_dba], ['Website', pr.website ? pr.website.replace(/^https?:\/\//, '') : null], ['State of registration', STATES[pr.state_of_registration]],
       ['Phone', phone(pr.phone)], ['Member terms', a.terms_version ? `Accepted ${day(pr.terms_accepted_at)}` : 'Not accepted']];
   } else if (a.account_type === 'individual') {
     main = [['Name', name], ['Company', pr.current_company], ['Email', pr.email], ['Member since', day(pr.created_at)], ['Role', WORKER_TYPES[pr.worker_type]]];
     more = [['Mobile', phone(pr.phone)]];
   } else {
     main = [['Name', name], ['Business', pr.business_legal_name], ['Email', pr.email], ['Member since', day(pr.created_at)]];
     more = [['DBA', pr.business_dba], ['State of registration', STATES[pr.state_of_registration]], ['Phone', phone(pr.phone)]];
   }
   main = main.filter(([, v]) => v); more = more.filter(([, v]) => v); %>
<section class="card dash-card">
  <h1 class="dash-band">Dashboard</h1>
  <div class="dash-body">
  <% if (typeof msg !== 'undefined' && msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <% if (a.account_type === 'company') { %>
    <% if (!fullAccess) { %>
      <div class="upgrade mt">
        <p class="flush">You can view and dispute reports about your company below. Searching and reporting require full access.</p>
        <div class="action-grid"><a class="btn" href="/dashboard/full-access">Get full access</a></div>
      </div>
    <% } %>
  <% } else { %>
    <p class="lead flush">View and dispute any report about <%= a.account_type === 'individual' ? 'you' : 'your business' %> at no cost.</p>
  <% } %>

  <h2 class="flush-top"><%= a.account_type === 'individual' ? 'Your profile' : a.account_type === 'company' ? 'Company profile' : 'Business profile' %></h2>
  <dl class="profile">
    <% main.forEach(([k, v]) => { %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %>
  </dl>
  <% if (more.length) { %>
  <details class="see-more">
    <summary><span class="when-closed">See more</span><span class="when-open">See less</span></summary>
    <dl class="profile">
      <% more.forEach(([k, v]) => { %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %>
    </dl>
  </details>
  <% } %>
  </div>
</section>

<% if (canUseApi) { %>
<section class="side-panel">
  <h2 class="flush-top">API access</h2>
  <p>Automatically check for reports of financing defaults or document tampering associated with a business.</p>
  <% if (!apiAccess || ['denied', 'revoked'].includes(apiAccess.status)) { %>
    <div class="action-grid"><a class="btn" href="/api-access">Request API access</a></div>
  <% } else if (apiAccess.status === 'requested') { %>
    <p class="muted flush">Requested. We&rsquo;ll email you once it has been reviewed.</p>
  <% } else { %>
    <div class="action-grid"><a class="btn" href="/api-access">Manage API keys</a></div>
  <% } %>
</section>
<% } %>
<% if (!fullAccess) { %>
<%- include('partials/about-me') %>
<% } %>
<%- include('partials/foot') %>
