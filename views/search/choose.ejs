<%- include('../partials/head') %>
<section class="card">
  <h1 class="title">Search</h1>
  <p class="lead">Who would you like to look up?</p>
  <div class="pick">
    <a class="pick-card tagged" href="/search/individual"><em class="pick-tag fcra">FCRA</em><strong>Screen an individual</strong><span>Employees and contractors. Employment screening only.</span></a>
    <a class="pick-card tagged" href="/search/vendor"><em class="pick-tag">Non-FCRA</em><strong>Check a vendor</strong><span>Service providers, broker partners and lender partners.</span></a>
    <a class="pick-card tagged" href="/search/merchant"><em class="pick-tag">Non-FCRA</em><strong>Check a merchant</strong><span>Businesses that applied for or received funding.</span></a>
  </div>
  <p class="muted example-links">New to FinDex? See example results for an <a href="/search/example/individual">individual</a>, a <a href="/search/example/vendor">vendor</a> or a <a href="/search/example/merchant">merchant</a>.</p>
</section>
<% if (recent.length) { %>
<section class="card">
  <h2 class="flush-top">Your recent searches</h2>
  <ul class="history">
    <% recent.forEach(s => { const c = s.criteria || {}; %>
      <li><a href="/search/results/<%= s.id %>"><%= c.name || c.domain || (c.ein ? 'Merchant by EIN' : R.SUBJECT_TYPES[s.subject_type] + ' search') %></a>
        <span class="muted">&middot; <%= R.SUBJECT_TYPES[s.subject_type] %> &middot; <%= s.result_report_ids.length %> report<%= s.result_report_ids.length === 1 ? '' : 's' %> &middot; <%= fmtDate(s.created_at) %></span></li>
    <% }) %>
  </ul>
</section>
<% } %>
<%- include('../partials/foot') %>
