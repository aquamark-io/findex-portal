<%- include('../partials/head') %>
<section class="card">
  <h1 class="title">Search</h1>
  <p class="lead">Who are you searching for?</p>
  <div class="pick">
    <a class="pick-card" href="/search/individual"><strong>An individual</strong><span>Full name plus email or date of birth</span></a>
    <a class="pick-card" href="/search/partner"><strong>A partner</strong><span>Company name or website</span></a>
    <a class="pick-card" href="/search/funded-business"><strong>A funded business</strong><span>Legal name and EIN</span></a>
  </div>
</section>
<% if (recent.length) { %>
<section class="card">
  <h2 class="flush-top">Your recent searches</h2>
  <ul class="history">
    <% recent.forEach(s => { const c = s.criteria || {}; %>
      <li><a href="/search/results/<%= s.id %>"><%= c.name || c.domain || 'Search' %></a>
        <span class="muted">&middot; <%= R.SUBJECT_TYPES[s.subject_type] %> &middot; <%= S.PURPOSES[s.purpose] %> &middot; <%= s.result_report_ids.length %> report<%= s.result_report_ids.length === 1 ? '' : 's' %> &middot; <%= fmtDate(s.created_at) %></span></li>
    <% }) %>
  </ul>
</section>
<% } %>
<%- include('../partials/foot') %>
