<%- include('../partials/head') %>
<section class="card">
  <h1 class="title">Search</h1>
  <p class="lead">What would you like to check? Searches are exact matches only. FinDex does not provide lists.</p>
  <div class="pick">
    <a class="pick-card" href="/search/funded-business"><strong>Check a funded business</strong><span>Before funding: reported defaults and document tampering, plus how many lenders searched it in the last 30 days. Search by EIN, legal name and state, or both.</span><em class="pick-tag">Not subject to FCRA</em></a>
    <a class="pick-card" href="/search/vendor"><strong>Check a vendor</strong><span>Before working with a service provider, broker partner or lender partner. Search by website or company name.</span><em class="pick-tag">Not subject to FCRA</em></a>
    <a class="pick-card" href="/search/individual"><strong>Screen an individual</strong><span>Employees and contractors, such as ISO reps. Name and date of birth, plus email or mobile.</span><em class="pick-tag fcra">Subject to FCRA &middot; employment screening only</em></a>
  </div>
</section>
<% if (recent.length) { %>
<section class="card">
  <h2 class="flush-top">Your recent searches</h2>
  <ul class="history">
    <% recent.forEach(s => { const c = s.criteria || {}; %>
      <li><a href="/search/results/<%= s.id %>"><%= c.name || c.domain || 'Search' %></a>
        <span class="muted">&middot; <%= R.SUBJECT_TYPES[s.subject_type] %> &middot; <%= S.PURPOSES[s.purpose] %> &middot; <%= s.result_report_ids.length %> report<%= s.result_report_ids.length === 1 ? '' : 's' %> &middot; <%= fmtDate(s.created_at) %></span></li>
    <% }) %>
  </ul>
</section>
<% } %>
<%- include('../partials/foot') %>
