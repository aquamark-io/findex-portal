<%- include('../partials/head') %>
<% const v = k => (values && typeof values[k] === 'string') ? values[k] : ''; const purposes = S.PURPOSES_FOR[subjectType]; %>
<section class="card">
  <p class="signing-as">Searching: <strong><%= R.SUBJECT_TYPES[subjectType] %></strong> &middot; <a href="/search">Change</a></p>
  <% const TITLES = { merchant: ['Check a funded business', 'See reported defaults and document tampering, and how many lenders searched this business in the last 30 days.'],
       company: ['Check a partner', 'See reports about a broker, lender, ISO or vendor before you work with them.'],
       individual: ['Screen an individual', 'See reports about an employee or contractor, for employment screening.'] }; %>
  <h1 class="title"><%= TITLES[subjectType][0] %></h1>
  <p class="lead"><%= TITLES[subjectType][1] %> Only published reports are shown, and every search is logged.</p>
  <% if (errors && errors.length) { %>
    <div class="alert error" role="alert"><strong>Please fix the following:</strong><ul class="errors"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/search/<%= who %>" enctype="multipart/form-data" id="search-form">
    <% if (subjectType === 'individual') { %>
      <div class="row">
        <div class="field"><label for="q_first">First name</label><input type="text" id="q_first" name="first_name" value="<%= v('first_name') %>" maxlength="80" required></div>
        <div class="field"><label for="q_last">Last name</label><input type="text" id="q_last" name="last_name" value="<%= v('last_name') %>" maxlength="80" required></div>
      </div>
      <div class="field"><label for="q_dob">Date of birth</label><input type="date" id="q_dob" name="dob" required></div>
      <p class="muted">Plus an email or mobile number. A match needs the date of birth and last name, and at least one of these.</p>
      <div class="row">
        <div class="field"><label for="q_email">Email</label><input type="email" id="q_email" name="email" value="<%= v('email') %>" maxlength="254"></div>
        <div class="field"><label for="q_phone">Mobile</label><input type="tel" id="q_phone" name="phone" value="<%= v('phone') %>" inputmode="tel" maxlength="20"></div>
      </div>
      <div class="field"><label for="q_zip">Home ZIP code <span class="hint">(optional)</span></label><input type="text" id="q_zip" name="zip" value="<%= v('zip') %>" inputmode="numeric" maxlength="5"></div>
    <% } else if (subjectType === 'company') { %>
      <div class="row">
        <div class="field"><label for="q_name">Company name</label><input type="text" id="q_name" name="name" value="<%= v('name') %>" maxlength="200"></div>
        <div class="field"><label for="q_site">Website</label><input type="text" id="q_site" name="website" value="<%= v('website') %>" placeholder="theircompany.com" inputmode="url" maxlength="200"></div>
      </div>
      <p class="muted">Enter either one. The website gives the most accurate match.</p>
    <% } else { %>
      <p class="muted">Enter what you have: the EIN, the legal name and state, or all three. The EIN gives the most accurate match.</p>
      <div class="field"><label for="q_ein">EIN</label><input type="text" id="q_ein" name="ein" inputmode="numeric" placeholder="XX-XXXXXXX" maxlength="10" autocomplete="off"></div>
      <div class="row">
        <div class="field"><label for="q_name">Business legal name</label><input type="text" id="q_name" name="name" value="<%= v('name') %>" maxlength="200"></div>
        <div class="field"><label for="q_state">State of registration</label><select id="q_state" name="state"><option value="">Select…</option><% Object.entries(STATES).forEach(([k, label]) => { %><option value="<%= k %>" <%= v('state') === k ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
      </div>
    <% } %>

    <% if (subjectType === 'individual') { %>
    <h2>Permissible purpose</h2>
    <p class="muted">Searches of individuals are subject to the Fair Credit Reporting Act (FCRA) and are offered for employment screening only, including independent contractors such as ISO reps.</p>
    <div class="field">
      <label for="purpose">Purpose of this search</label>
      <select id="purpose" name="purpose" required>
        <% if (purposes.length > 1) { %><option value="">Select…</option><% } %>
        <% purposes.forEach(p => { %><option value="<%= p %>" <%= v('purpose') === p ? 'selected' : '' %>><%= S.PURPOSES[p] %></option><% }) %>
      </select>
    </div>
    <% } else { %>
    <p class="muted mt">Not subject to the FCRA. Exact matches only.</p>
    <% } %>

    <% if (subjectType === 'individual') { %>
    <fieldset id="employment-fields" hidden disabled>
      <div class="card-inset">
        <p class="flush"><strong>Employment screening</strong></p>
        <label class="check mt"><input type="checkbox" name="employment_certify" required><span>On behalf of <%= account.business_legal_name %>, I certify that we gave this individual a clear and conspicuous standalone written disclosure that a report may be obtained for employment purposes, obtained their written authorization (attached), will send pre-adverse and adverse action notices with a copy of the report and the CFPB Summary of Rights before taking any adverse action, and will not use this information in violation of any equal employment opportunity law.</span></label>
        <div class="field"><label for="authorization">Signed disclosure &amp; authorization</label>
          <input type="file" id="authorization" name="authorization" accept=".pdf,.png,.jpg,.jpeg,.heic,.webp" required>
          <p class="field-hint">PDF or image, up to 25 MB.</p>
        </div>
      </div>
    </fieldset>
    <% } %>

    <% if (subjectType === 'individual') { %>
    <label class="check mt"><input type="checkbox" name="certify" required><span>On behalf of <%= account.business_legal_name %>, I certify that this search is for the purpose selected above and the results will be used only for that purpose.</span></label>
    <% } else { %>
    <label class="check mt"><input type="checkbox" name="certify" required><span>On behalf of <%= account.business_legal_name %>, I confirm the results will be used only to evaluate this <%= subjectType === 'company' ? 'partner' : 'business' %>, not for marketing or solicitation.</span></label>
    <% } %>
    <button class="btn block" type="submit">Search</button>
  </form>
</section>
<script src="/js/search-form.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
