<%- include('../partials/head') %>
<% const v = k => (values && typeof values[k] === 'string') ? values[k] : ''; %>
<section class="card">
  <p class="signing-as">Searching: <strong><%= R.SUBJECT_TYPES[subjectType] %></strong> &middot; <a href="/search">Change</a></p>
  <% const TITLES = { merchant: 'Check a merchant', company: 'Check a vendor', individual: 'Screen an individual' }; %>
  <h1 class="title"><%= TITLES[subjectType] %></h1>
  <% if (subjectType === 'merchant') { %>
  <ul class="you-get" aria-label="What this search checks">
    <li>Reported <strong>defaults</strong></li>
    <li>Reported <strong>document tampering</strong></li>
    <li>How many other companies <strong>searched this merchant</strong> in the past 30 days</li>
  </ul>
  <% } else { %>
  <p class="lead">Only published reports are shown, and every search is logged.</p>
  <% } %>
  <% if (errors && errors.length) { %>
    <div class="alert error" role="alert"><strong>Please fix the following:</strong><ul class="errors"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/search/<%= who %>" enctype="multipart/form-data" id="search-form">
    <% if (subjectType === 'individual') { %>
      <div class="row">
        <div class="field"><label for="q_first">First name</label><input type="text" id="q_first" name="first_name" value="<%= v('first_name') %>" maxlength="80" required></div>
        <div class="field"><label for="q_last">Last name</label><input type="text" id="q_last" name="last_name" value="<%= v('last_name') %>" maxlength="80" required></div>
      </div>
      <div class="field"><label for="q_dob">Date of birth</label><input type="date" id="q_dob" name="dob" required></div>
      <div class="row">
        <div class="field"><label for="q_email">Email</label><input type="email" id="q_email" name="email" value="<%= v('email') %>" maxlength="254"></div>
        <div class="field"><label for="q_phone">Mobile</label><input type="tel" id="q_phone" name="phone" value="<%= v('phone') %>" inputmode="tel" maxlength="20"></div>
      </div>
      <div class="field"><label for="q_zip">Home ZIP code <span class="hint">(optional)</span></label><input type="text" id="q_zip" name="zip" value="<%= v('zip') %>" inputmode="numeric" maxlength="5"></div>
    <% } else if (subjectType === 'company') { %>
      <div class="row">
        <div class="field"><label for="q_name">Company name</label><input type="text" id="q_name" name="name" value="<%= v('name') %>" maxlength="200"></div>
        <div class="field"><label for="q_site">Website</label><input type="text" id="q_site" name="website" value="<%= v('website') %>" placeholder="theircompany.com" inputmode="url" maxlength="200"></div>
      </div>
      <p class="muted">Enter either one. The website gives the most accurate match.</p>
    <% } else { %>
      <p class="muted">Search by EIN, or by legal name and state.</p>
      <div class="field"><label for="q_ein">EIN <span class="hint">(most accurate)</span></label><input type="text" id="q_ein" name="ein" inputmode="numeric" placeholder="XX-XXXXXXX" maxlength="10" autocomplete="off"></div>
      <div class="row">
        <div class="field"><label for="q_name">Business legal name</label><input type="text" id="q_name" name="name" value="<%= v('name') %>" maxlength="200"></div>
        <div class="field"><label for="q_state">State of registration</label><select id="q_state" name="state"><option value="">Select…</option><% Object.entries(STATES).forEach(([k, label]) => { %><option value="<%= k %>" <%= v('state') === k ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
      </div>
    <% } %>

    <% if (subjectType === 'individual') { %>
    <div class="card-inset mt">
      <p class="flush"><strong>Employment screening</strong> <span class="muted">&middot; Subject to the FCRA</span></p>
      <label class="check mt"><input type="checkbox" name="certify" required><span>On behalf of <%= account.business_legal_name %>, I certify that this search is for employment screening only, that this individual signed a background check authorization, and that we will follow the FCRA when required.</span></label>
      <div class="field flush"><label for="authorization">Signed background check authorization</label>
        <input type="file" id="authorization" name="authorization" accept=".pdf,.png,.jpg,.jpeg,.heic,.webp" required>
        <p class="field-hint">Attach the background check authorization they signed, such as the one in your onboarding packet. PDF or image, up to 25 MB.</p>
      </div>
    </div>
    <% } else { %>
    <label class="check mt"><input type="checkbox" name="certify" required><span>On behalf of <%= account.business_legal_name %>, I confirm the results will be used only to evaluate this <%= subjectType === 'company' ? 'vendor' : 'business' %>, not for marketing or solicitation.</span></label>
    <% } %>
    <button class="btn block" type="submit">Search</button>
    <% if (subjectType === 'merchant') { %><p class="muted center fine">Only published reports are shown. Every search is logged.</p><% } %>
  </form>
</section>
<script src="/js/search-form.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
