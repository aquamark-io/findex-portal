<%- include('partials/head') %>
<section class="card raw">
  <div class="raw-top">
    <h1 class="title flush">Activity</h1>
    <a href="/reports/new">+ Submit a report</a>
  </div>
  <% if (msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <form method="get" action="/activity" class="raw-filters">
    <label>Show <select name="show"><% Object.entries(SHOW).forEach(([k, l]) => { %><option value="<%= k %>" <%= show === k ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
    <label>About <select name="type"><option value="all">Anyone</option><% Object.entries(R.SUBJECT_TYPES).forEach(([k, l]) => { %><option value="<%= k %>" <%= type === k ? 'selected' : '' %>><%= l %>s</option><% }) %></select></label>
    <button type="submit" class="link-btn">Apply</button>
    <% if (show !== 'all' || type !== 'all') { %><a href="/activity">Clear</a><% } %>
  </form>
  <table class="raw-table">
    <thead><tr><th>Date</th><th>Activity</th><th>Name</th><th>Details</th></tr></thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr><td class="nowrap"><%= fmtDate(i.date) %></td><td><%= KIND[i.kind] %></td>
          <td><% if (i.href) { %><a href="<%= i.href %>"><%= i.name %></a><% } else { %><%= i.name %><% } %></td>
          <td class="muted"><%= [R.SUBJECT_TYPES[i.type], i.detail].filter(Boolean).join(' · ') %></td></tr>
      <% }) %>
      <% if (!items.length && !examples.length) { %><tr><td colspan="4" class="muted">Nothing matches these filters.</td></tr><% } %>
      <% examples.forEach(i => { %>
        <tr class="raw-ex"><td class="nowrap">Example</td><td><%= KIND[i.kind] %></td>
          <td><a href="<%= i.href %>"><%= i.name %></a></td>
          <td class="muted"><%= [R.SUBJECT_TYPES[i.type], i.detail].filter(Boolean).join(' · ') %></td></tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/foot') %>
