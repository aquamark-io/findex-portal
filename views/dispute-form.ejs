<%- include('partials/head') %>
<section class="card">
  <p class="signing-as"><a href="/dashboard">&larr; Your record</a></p>
  <h1 class="title">Dispute a report</h1>
  <p class="lead"><%= CATEGORIES[r.category].label %> &middot; reported by <%= r.reporter ? r.reporter.business_legal_name : '' %></p>
  <p class="prewrap muted"><%= r.description %></p>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/my-record/reports/<%= r.id %>/dispute" enctype="multipart/form-data">
    <div class="field"><label for="reason">Why is this report inaccurate?</label>
      <textarea id="reason" name="reason" rows="7" minlength="20" maxlength="5000" required placeholder="Explain what is wrong and what actually happened."><%= reason %></textarea></div>
    <div class="field"><label for="files">Supporting documents <span class="hint">(optional)</span></label>
      <input type="file" id="files" name="files" multiple accept="<%= '.pdf,.png,.jpg,.jpeg,.heic,.webp,.eml,.msg,.csv,.xls,.xlsx,.docx,.mp3,.m4a,.wav' %>">
      <p class="field-hint">Up to 5 files, 25 MB each.</p></div>
    <p class="muted">The report is withheld as soon as you submit, while we review the evidence from both sides. We complete our review within 30 days.</p>
    <button class="btn block" type="submit">Submit dispute</button>
  </form>
</section>
<%- include('partials/foot') %>
