<%- include('partials/head') %>
<section class="card narrow">
  <h1 class="title">Sign In</h1>
  <p class="lead">We&rsquo;ll send you a one-time code.</p>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login">
    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="<%= email %>" autocomplete="email" maxlength="254" required autofocus></div>
    <button class="btn block" type="submit">Send sign-in code</button>
  </form>
  <p class="muted mt center">Don&rsquo;t have an account? <a href="/request-access">Request access</a> or <a href="/check-my-record">check your record</a>.</p>
</section>
<%- include('partials/foot') %>
