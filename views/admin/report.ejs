<%- include('../partials/head', { wide: true }) %>
<%
  const r = report, s = subject;
  const subjRows = [
    ['Type', R.SUBJECT_TYPES[s.subject_type]],
    ['Name', s.name + (s.name !== r.subject_name_reported ? ` (reported as "${r.subject_name_reported}")` : '')],
    ['DBA', s.dba], ['Website', s.website], ['Contact', s.contact_name],
    ...identity,
    ['Notice email', r.notice_email],
    ['Other emails on file', subjectEmails.filter(e => e !== r.notice_email).join(', ')],
    ['Other reports about them', otherReports ? String(otherReports) : 'None'],
  ].filter(([, v]) => v);
%>
<p><a href="/admin/reports?status=<%= r.status %>">&larr; Back to reports</a></p>
<h1 class="title"><%= r.subject_name_reported %></h1>
<p class="lead"><span class="pill <%= r.status %>"><%= STATUS_LABELS[r.status] %></span></p>
<% if (msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
<% if (err) { %><div class="alert error" role="alert"><%= err %></div><% } %>

<section class="card ai-card">
    <h2 class="flush-top">AI evidence review</h2>
    <% const ai = aiReview; const checkLabels = { matches_reported_party: 'Matches the reported party', supports_incident: 'Supports the incident', dates_consistent: 'Dates consistent', required_documents_present: 'Required documents present', evidence_quality: 'Evidence quality' }; %>
    <% if (!aiEnabled) { %>
      <p class="muted">Off. Add ANTHROPIC_API_KEY in Render to turn it on.</p>
    <% } else if (!ai) { %>
      <p class="muted">No AI review yet.</p>
    <% } else if (ai.status === 'running') { %>
      <p class="muted">Reviewing the evidence&hellip; refresh in a minute.</p>
    <% } else if (ai.status === 'failed') { %>
      <div class="alert error">AI review failed: <%= ai.error %></div>
    <% } else if (!(ai.result && ai.result.requirements)) { %>
      <p class="muted">This review used an older format. Run it again for the short version.</p>
    <% } else { const res = ai.result; const reqs = R.REQUIREMENTS[r.category] || []; %>
      <ul class="ai-reqs">
        <% reqs.forEach((text, i) => { const x = (res.requirements || []).find(q => q.number === i + 1) || { result: 'unclear', note: 'Not answered' }; %>
          <li><span class="ai-box<%= x.result === 'yes' ? ' on' : '' %>" role="img" aria-label="<%= x.result === 'yes' ? 'Shown' : 'Not shown' %>"><%= x.result === 'yes' ? '\u2713' : '' %></span><span><strong><%= text %></strong><span class="muted"> &mdash; <%= x.note %></span></span></li>
        <% }) %>
      </ul>
      <% if ((ai.files_skipped || []).length) { %><p class="muted ai-meta">AI couldn&rsquo;t read: <%= ai.files_skipped.map(x => x.file).join(', ') %></p><% } %>
    <% } %>
    <% if (aiEnabled) { %>
      <form method="post" action="/admin/reports/<%= r.id %>/ai-review"><button class="btn secondary" type="submit"><%= ai ? 'Run AI review again' : 'Run AI review' %></button></form>
    <% } %>
  </section>

<div class="detail-grid">
  <section class="card">
    <h2 class="flush-top">Report</h2>
    <dl class="kv">
      <dt>Category</dt><dd><%= R.CATEGORIES[r.category].label %></dd>
      <dt>Incident date</dt><dd><%= dateOnly(r.incident_date) %></dd>
      <dt>Submitted</dt><dd><%= fmt(r.created_at) %></dd>
      <dt>Reported by</dt><dd><a href="/admin/accounts/<%= reporter.id %>"><%= reporter.business_legal_name %></a> (<%= COMPANY_TYPES[reporter.company_type] || 'Company' %>), <%= reporter.first_name %> <%= reporter.last_name %></dd>
      <dt>Expires</dt><dd><%= dateOnly(r.expires_on || (r.incident_date && (Number(r.incident_date.slice(0, 4)) + 7) + r.incident_date.slice(4))) %></dd>
    </dl>
    <h2>Description</h2>
    <p class="prewrap"><%= r.description %></p>
    <h2>Evidence (<%= files.length %>)</h2>
    <ul class="checklist">
      <% files.forEach(f => { %><li><a href="/admin/reports/<%= r.id %>/files/<%= f.id %>" target="_blank" rel="noopener"><%= f.file_name %></a> <span class="muted">(<%= R.fmtSize(f.size_bytes) %><%= f.kind === 'default_notice' ? ', default notice' : '' %>)</span></li><% }) %>
    </ul>
    <h2>Who it&rsquo;s about</h2>
    <dl class="kv"><% subjRows.forEach(([k, v]) => { %><dt><%= k %></dt><dd><%= v %></dd><% }) %></dl>
  </section>

  <section class="card">
    <h2 class="flush-top">Decision</h2>
    <% if (r.status === 'submitted') { %>
      <form method="post" class="decision">
        <div class="field"><label for="reason">Reason for rejecting <span class="hint">(shared with the reporter)</span></label><textarea id="reason" name="reason" rows="3" maxlength="2000"></textarea></div>
        <div class="field"><label for="note">Internal note <span class="hint">(optional, never emailed)</span></label><textarea id="note" name="note" rows="2" maxlength="2000"></textarea></div>
        <div class="actions">
          <button class="btn" type="submit" formaction="/admin/reports/<%= r.id %>/accept" data-confirm="Accept this report and email the notice to <%= r.notice_email %>? The 10 days start now.">Accept &amp; send notice</button>
          <button class="btn danger" type="submit" formaction="/admin/reports/<%= r.id %>/reject" data-confirm="Reject this report and email the reason to <%= reporter.email %>?">Reject</button>
        </div>
        <p class="muted">Accepting emails the notice to <%= r.notice_email %> and starts the 10-day window. The reason box is only used if you reject.</p>
      </form>
    <% } else if (['notice_sent', 'published', 'notice_undeliverable', 'disputed', 'removed'].includes(r.status)) { %>
      <% if (r.status === 'disputed') { %><p><strong>Withheld:</strong> under dispute. See below.</p><% } %>
      <% if (r.status === 'removed') { %><p><strong>Removed</strong> <%= fmtDay(r.removed_at) %>.</p><% } %>
      <% if (r.status === 'notice_sent' && r.publish_at) { %><p><strong>Publishes <%= fmtDay(r.publish_at) %></strong> unless disputed.</p><% } %>
      <% if (r.status === 'published') { %><p><strong>Published <%= fmtDay(r.published_at) %>.</strong></p><% } %>
      <% if (r.status === 'notice_undeliverable') { %><p><strong>Paused:</strong> the notice couldn&rsquo;t be delivered. The reporter has been asked for another email address. It won&rsquo;t publish until a notice is delivered.</p><% } %>
    <% } else if (r.status === 'rejected') { %>
      <p><strong>Rejected:</strong> <%= r.rejection_reason %></p>
      <% if (r.review_note) { %><p class="muted">Internal note: <%= r.review_note %></p><% } %>
    <% } %>
    <% disputes.forEach(d => { const files = d.fx_dispute_files || []; %>
      <h2>Dispute <span class="pill <%= d.status %>"><%= d.status.charAt(0).toUpperCase() + d.status.slice(1) %></span></h2>
      <p class="muted flush"><%= d.fx_accounts ? d.fx_accounts.first_name + ' ' + d.fx_accounts.last_name + ' (' + d.fx_accounts.email + ')' : '' %> &middot; opened <%= fmt(d.created_at) %> &middot; <strong>due <%= fmtDay(d.due_at) %></strong></p>
      <p class="prewrap"><%= d.reason %></p>
      <% if (files.length) { %><ul class="checklist"><% files.forEach(f => { %><li><a href="/admin/disputes/files/<%= f.id %>" target="_blank" rel="noopener"><%= f.file_name %></a> <span class="muted">(<%= f.party === 'subject' ? 'reported party' : 'reporter' %>)</span></li><% }) %></ul><% } %>
      <p class="muted flush">Reporter&rsquo;s response<%= d.reporter_responded_at ? ' (' + fmt(d.reporter_responded_at) + ')' : '' %>:</p>
      <p class="prewrap"><%= d.reporter_response || 'None yet.' %></p>
      <% if (d.resolution_note) { %><p><strong>Resolution:</strong> <%= d.resolution_note %></p><% } %>
      <% if (d.status === 'open') { %>
        <form method="post" action="/admin/reports/<%= r.id %>/resolve" class="card-inset">
          <div class="choice">
            <label><input type="radio" name="outcome" value="upheld" required>Uphold<small>Publish as is</small></label>
            <label><input type="radio" name="outcome" value="amended">Amend<small>Publish with corrections</small></label>
            <label><input type="radio" name="outcome" value="removed">Remove<small>Take it down</small></label>
          </div>
          <div class="field mt"><label for="amended_description">Corrected description <span class="hint">(amend only)</span></label><textarea id="amended_description" name="amended_description" rows="4" maxlength="5000"><%= r.description %></textarea></div>
          <div class="field"><label for="rnote">Resolution note <span class="hint">(shared with both sides)</span></label><textarea id="rnote" name="note" rows="3" maxlength="2000" required></textarea></div>
          <button class="btn" type="submit" data-confirm="Resolve this dispute and email both sides?">Resolve dispute</button>
        </form>
      <% } %>
    <% }) %>

    <% if (notices.length) { %>
      <h2>Notices</h2>
      <ul class="history">
        <% notices.forEach(n => { %>
          <li>
            <%= n.channel === 'email' ? n.email : 'Letter' %>:
            <strong><%= { sent: 'sent', bounced: 'bounced', failed: 'could not send', to_mail: 'waiting to be mailed', mailed: 'mailed' }[n.status] %></strong>
            <span class="muted"><%= fmt(n.sent_at || n.mailed_at || n.created_at) %></span>
            <% if (n.bounce_detail && n.status !== 'sent') { %><div class="muted"><%= n.bounce_detail %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <h2>Reported party&rsquo;s account</h2>
    <% if (links.length) { %>
      <ul class="history"><% links.forEach(l => { const a = l.fx_accounts || {}; %><li><a href="/admin/accounts/<%= a.id %>"><%= a.business_legal_name || (a.first_name + ' ' + a.last_name) %></a> <span class="muted">(<%= a.email %>, matched by <%= { email: 'email', identity: 'identity details', domain: 'domain', admin: 'you' }[l.linked_by] %>)</span></li><% }) %></ul>
    <% } else { %>
      <p class="muted">Not linked yet. They&rsquo;re linked automatically when they sign up with the notice email or matching identity details.</p>
    <% } %>
    <form method="post" action="/admin/reports/<%= r.id %>/link" class="inline-form">
      <input type="email" name="email" placeholder="Link an approved account by email" required aria-label="Account email">
      <button class="btn secondary" type="submit">Link</button>
    </form>

    <% if (r.is_test) { %>
      <form method="post" action="/admin/reports/<%= r.id %>/delete" class="mt"><button class="btn secondary" type="submit" data-confirm="Permanently delete this TEST report and its files?">Delete test report</button></form>
    <% } %>

    <h2>History</h2>
    <% if (!events.length) { %><p class="muted">No events yet.</p><% } else { %>
      <ul class="history"><% events.forEach(e => { %><li><span class="muted nowrap"><%= fmt(e.created_at) %></span> <%= eventLabel(e) %><% if (e.detail && e.detail.file) { %>: <%= e.detail.file %><% } %> <span class="muted">(<%= ACTORS[e.actor] || e.actor %>)</span></li><% }) %></ul>
    <% } %>
  </section>
</div>
<script src="/js/admin.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
