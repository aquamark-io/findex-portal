<%- include('../partials/head', { wide: true }) %>
<h1 class="title">Search log</h1>
<p class="lead">Every search, with its certified purpose. DOB, SSN and EIN values are never stored.</p>
<% if (!searches.length) { %>
  <div class="card"><p class="lead flush">No searches yet.</p></div>
<% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>When</th><th>Searched by</th><th>For</th><th>Purpose</th><th>Results</th></tr></thead>
    <tbody>
      <% searches.forEach(s => { const c = s.criteria || {}; %>
        <tr>
          <td class="nowrap"><%= fmt(s.created_at) %></td>
          <td><% if (s.fx_accounts) { %><a href="/admin/accounts/<%= s.fx_accounts.id %>"><%= s.fx_accounts.business_legal_name %></a><% } %></td>
          <td><strong><%= c.name || c.domain %></strong><div class="muted"><%= R.SUBJECT_TYPES[s.subject_type] %><%= [c.email && 'email', c.domain && 'website', c.dob && 'DOB', c.ssn_last4 && 'SSN last 4', c.ein && 'EIN'].filter(Boolean).map(x => ' · ' + x).join('') %></div></td>
          <td><%= PURPOSES[s.purpose] %><% if (s.authorization_id) { %><div><a href="/admin/authorizations/<%= s.authorization_id %>" target="_blank" rel="noopener">Authorization</a></div><% } %></td>
          <td><%= s.result_report_ids.length %> report<%= s.result_report_ids.length === 1 ? '' : 's' %><div class="muted"><%= s.matched_subject_ids.length %> match<%= s.matched_subject_ids.length === 1 ? '' : 'es' %></div></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>
<%- include('../partials/foot') %>
