<%- include('../partials/head') %>
<% const s = report.fx_subjects || {}; %>
<section class="card">
  <% if (submitted) { %><div class="alert ok" role="status">Report submitted. We&rsquo;ll email you once it has been reviewed.</div><% } %>
  <p class="signing-as"><a href="/reports">&larr; Your reports</a></p>
  <h1 class="title"><%= report.subject_name_reported %></h1>
  <p class="lead"><span class="pill <%= report.status %>"><%= STATUS_LABELS[report.status] %></span></p>
  <% if (msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <% if (err) { %><div class="alert error" role="alert"><%= err %></div><% } %>
  <% if (report.status === 'notice_sent' && report.publish_at) { %><div class="alert ok">The reported party has been notified. Publishes <strong><%= fmtDay(report.publish_at) %></strong> unless disputed.</div><% } %>
  <% if (report.status === 'published') { %><div class="alert ok">Published <%= fmtDay(report.published_at) %>.</div><% } %>
  <% if (report.status === 'notice_undeliverable') { %>
    <div class="alert error"><strong>Action needed:</strong> we couldn&rsquo;t deliver the notice to <%= report.notice_email %>. The report is paused until the reported party can be notified.</div>
    <form method="post" action="/reports/<%= report.id %>/contact" class="card-inset">
      <div class="field"><label for="c_email">Another email address for the reported party</label><input type="email" id="c_email" name="email" maxlength="254" required></div>
      <p class="muted">The report can&rsquo;t be published until a notice is delivered.</p>
      <button class="btn" type="submit">Send notice</button>
    </form>
  <% } %>
  <% if (report.status === 'rejected' && report.rejection_reason) { %>
    <div class="alert error"><strong>Not accepted:</strong> <%= report.rejection_reason %></div>
  <% } %>
  <% if (dispute) { %>
    <div class="card-inset">
      <p class="flush"><strong><%= dispute.status === 'open' ? 'Disputed: please respond' : 'Dispute ' + dispute.status %></strong>
        <span class="muted">&middot; <%= dispute.status === 'open' ? 'decision by ' + fmtDay(dispute.due_at) : fmtDay(dispute.resolved_at) %></span></p>
      <p class="prewrap"><%= dispute.reason %></p>
      <% const theirs = dFiles.filter(f => f.party === 'subject'); if (theirs.length) { %>
        <ul class="checklist"><% theirs.forEach(f => { %><li><a href="/reports/<%= report.id %>/dispute-files/<%= f.id %>" target="_blank" rel="noopener"><%= f.file_name %></a></li><% }) %></ul>
      <% } %>
      <% if (dispute.reporter_response) { %><p class="muted flush">Your response:</p><p class="prewrap"><%= dispute.reporter_response %></p><% } %>
      <% if (dispute.resolution_note) { %><p><strong>Outcome:</strong> <%= dispute.resolution_note %></p><% } %>
      <% if (dispute.status === 'open') { %>
        <form method="post" action="/reports/<%= report.id %>/respond" enctype="multipart/form-data" class="mt">
          <div class="field"><label for="response">Your response</label><textarea id="response" name="response" rows="4" maxlength="5000" placeholder="Address the dispute and point to the supporting evidence."></textarea></div>
          <div class="field"><label for="rfiles">Additional evidence <span class="hint">(optional, up to 5 files)</span></label><input type="file" id="rfiles" name="files" multiple></div>
          <button class="btn" type="submit">Send response</button>
        </form>
      <% } %>
    </div>
  <% } %>
  <dl class="kv">
    <dt>Reported party</dt><dd><%= R.SUBJECT_TYPES[s.subject_type] %></dd>
    <% if (s.website) { %><dt>Website</dt><dd><%= s.website %></dd><% } %>
    <% if (s.contact_name) { %><dt>Contact</dt><dd><%= s.contact_name %></dd><% } %>
    <dt>Notice email</dt><dd><%= report.notice_email %></dd>
    <dt>Category</dt><dd><%= R.CATEGORIES[report.category].label %></dd>
    <dt><%= (R.REPAYMENT_FIELDS[report.category] || {}).dateLabel || 'Incident date' %></dt><dd><%= fmtDate(report.incident_date) %></dd>
    <% if (report.payment_amount != null) { %><dt><%= R.REPAYMENT_FIELDS[report.category].amountLabel %></dt><dd><%= R.fmtMoney(report.payment_amount) %></dd><% } %>
    <dt>Submitted</dt><dd><%= fmtDate(report.created_at) %></dd>
  </dl>
  <% if (report.description) { %><h2>Description</h2>
  <p class="prewrap"><%= report.description %></p><% } %>
  <h2>Evidence</h2>
  <ul class="checklist">
    <% files.forEach(f => { %><li><%= f.file_name %> <span class="muted">(<%= R.fmtSize(f.size_bytes) %><%= f.kind === 'default_notice' ? ', default notice' : '' %>)</span></li><% }) %>
  </ul>
</section>
<%- include('../partials/foot') %>
