<%- include('../partials/head') %>
<% const day = n => new Date(Date.now() - n * 864e5).toISOString().slice(0, 10);
   // Shown until the member submits a report, so they can see how reports and statuses appear.
   const examples = [
     { created_at: day(2), subject_name_reported: 'Jordan Rivera', type: 'individual', category: 'data_theft', incident_date: day(30), status: 'submitted' },
     { created_at: day(9), subject_name_reported: 'Leaky CRM Inc', type: 'company', category: 'data_mishandling', incident_date: day(60), status: 'notice_sent' },
     { created_at: day(40), subject_name_reported: 'Joe’s Cafe LLC', type: 'merchant', category: 'default', incident_date: day(55), status: 'published' },
   ];
   const ex = !reports.length;
   const rows = ex ? examples : reports; %>
<section class="card dash-card">
  <h1 class="dash-band">Reports</h1>
  <div class="dash-body">
  <% if (typeof msg !== 'undefined' && msg) { %><div class="alert ok" role="status"><%= msg %></div><% } %>
  <div class="report-actions">
    <a class="btn" href="/reports/new">Submit a report</a>
    <a class="btn secondary" href="/reports/about">Reports about <%= account.account_type === 'company' ? 'your company' : 'you' %><% if (aboutMe.length) { %> (<%= aboutMe.length %>)<% } %></a>
  </div>
<% if (ex) { %><p class="muted">You haven&rsquo;t submitted any reports yet. Here&rsquo;s how they&rsquo;ll appear:</p><% } %>
<div class="table-wrap stack-wrap"><table class="table stack-table">
  <thead><tr><th>Submitted</th><th>About</th><th>Category</th><th>Incident date</th><th>Status</th></tr></thead>
  <tbody>
    <% rows.forEach(r => { const type = ex ? r.type : (r.fx_subjects && r.fx_subjects.subject_type); %>
      <tr class="<%= ex ? 'example-row' : '' %>">
        <td class="nowrap" data-label="Submitted"><%= fmtDate(r.created_at) %></td>
        <td data-label="About" class="stack-title">
          <% if (ex) { %><span class="example-tag">Example</span> <strong><%= r.subject_name_reported %></strong><% } else { %><a href="/reports/<%= r.id %>"><strong><%= r.subject_name_reported %></strong></a><% } %>
          <div class="muted"><%= R.SUBJECT_TYPES[type] || '' %></div></td>
        <td data-label="Category"><%= R.CATEGORIES[r.category].label %></td>
        <td class="nowrap" data-label="Incident date"><%= fmtDate(r.incident_date) %></td>
        <td data-label="Status"><span class="pill <%= r.status %>"><%= STATUS_LABELS[r.status] %></span></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>
  </div>
</section>
<%- include('../partials/foot') %>
