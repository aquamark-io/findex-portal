<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>FinDex</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/portal.css?v=<%= assetV %>">
</head>
<body>
<header class="band">
  <div class="band-inner">
    <a class="wordmark" href="<%= marketingUrl %>" aria-label="FinDex home">Fin<span>Dex</span></a>
    <% const hasNav = typeof adminNav === 'undefined' || adminNav; %>
    <% if (hasNav) { %>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <% } %>
    <% const here = p => (currentPath !== '/request-access/received' && (currentPath === p || currentPath.startsWith(p + '/'))) ? 'class="nav-link active" aria-current="page"' : 'class="nav-link"'; %>
    <nav class="nav-actions" id="site-nav" aria-label="Account">
      <% if (typeof adminNav !== 'undefined') { %>
        <% if (adminNav) { %>
          <a <%- (currentPath.startsWith('/admin/reports') || currentPath.startsWith('/admin/searches') || currentPath.startsWith('/admin/disputes')) ? 'class="nav-link"' : here('/admin') %> href="/admin">Requests</a>
          <a <%- here('/admin/reports') %> href="/admin/reports">Reports</a>
          <a <%- here('/admin/disputes') %> href="/admin/disputes">Disputes</a>
          <a <%- here('/admin/searches') %> href="/admin/searches">Searches</a>
          <form method="post" action="/admin/logout"><button class="nav-link link-reset" type="submit">Sign Out</button></form>
        <% } %>
      <% } else if (typeof account !== 'undefined' && account) { %>
        <a <%- here('/dashboard') %> href="/dashboard">Dashboard</a>
        <% if (account.account_type === 'company' && account.terms_version) { %><a <%- here('/search') %> href="/search">Search</a><a <%- here('/reports') %> href="/reports">Reports</a><% } %>
        <form method="post" action="/logout"><button class="nav-link link-reset" type="submit">Sign Out</button></form>
      <% } else { %>
        <a <%- here('/check-my-record') %> href="/check-my-record">Check My Record</a>
        <a <%- here('/request-access') %> href="/request-access">Request Access</a>
        <a <%- here('/login') %> href="/login">Sign In</a>
      <% } %>
    </nav>
  </div>
</header>
<script src="/js/nav.js?v=<%= assetV %>" defer></script>
<main class="main<%= typeof wide !== 'undefined' && wide ? ' wide' : '' %>">
